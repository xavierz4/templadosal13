---
// Un array estático mock de Autoridad (Marcas/Certificaciones)
// Duplicamos deliberadamente el array en la plantilla para lograr un infinite scroll perfecto
const logos = [
  { name: 'ISO 9001', svg: '<svg viewBox="0 0 100 40" class="h-8 md:h-12 w-auto fill-current"><text x="10" y="30" font-family="monospace" font-weight="bold" font-size="28">ISO 9001</text></svg>' },
  { name: 'Constructora Sólida', svg: '<svg viewBox="0 0 120 40" class="h-8 md:h-12 w-auto fill-current"><path d="M10,35 L30,5 L50,35 Z" /><text x="60" y="28" font-family="sans-serif" font-weight="900" font-size="20">SÓLIDA</text></svg>' },
  { name: 'Aluminios Corp', svg: '<svg viewBox="0 0 150 40" class="h-8 md:h-12 w-auto fill-current"><rect x="5" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="4"/><text x="45" y="28" font-family="serif" font-style="italic" font-weight="bold" font-size="24">Aluminios</text></svg>' },
  { name: 'NSR 10 Compliant', svg: '<svg viewBox="0 0 130 40" class="h-8 md:h-12 w-auto fill-current"><circle cx="20" cy="20" r="15" fill="none" stroke="currentColor" stroke-width="3"/><text x="45" y="28" font-family="monospace" font-weight="bold" font-size="24">NSR-10</text></svg>' },
  { name: 'Vidrios Seguros', svg: '<svg viewBox="0 0 140 40" class="h-8 md:h-12 w-auto fill-current"><polygon points="20,5 35,35 5,35" fill="none" stroke="currentColor" stroke-width="3"/><text x="45" y="28" font-family="sans-serif" font-weight="bold" font-size="22">Seguros</text></svg>' },
  { name: 'Arquitectura Elite', svg: '<svg viewBox="0 0 160 40" class="h-8 md:h-12 w-auto fill-current"><line x1="5" y1="20" x2="35" y2="20" stroke="currentColor" stroke-width="6"/><line x1="20" y1="5" x2="20" y2="35" stroke="currentColor" stroke-width="6"/><text x="45" y="28" font-family="sans-serif" font-weight="800" font-size="24">ELITE ARQ</text></svg>' },
  { name: 'Garantía 10 Años', svg: '<svg viewBox="0 0 130 40" class="h-8 md:h-12 w-auto fill-current"><rect x="10" y="10" width="20" height="20" transform="rotate(45 20 20)" fill="none" stroke="currentColor" stroke-width="2"/><text x="45" y="28" font-family="sans-serif" font-weight="normal" font-size="20">10 Años</text></svg>' },
];
---

<section class="py-12 bg-black border-y border-white/5 relative overflow-hidden flex flex-col items-center">
  <div class="absolute inset-0 pointer-events-none z-10 w-full">
    <!-- Sombras de viñeta para dar profundidad a las esquinas del carrusel -->
    <div class="absolute inset-y-0 left-0 w-1/4 bg-gradient-to-r from-black to-transparent"></div>
    <div class="absolute inset-y-0 right-0 w-1/4 bg-gradient-to-l from-black to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mb-6 relative z-20 w-full text-center">
    <p class="text-zinc-500 font-mono text-xs uppercase tracking-widest font-semibold opacity-70">
      Estándares y Socios Estratégicos
    </p>
  </div>

  <div class="w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
    <!-- Track primario que se desplaza infinitamente hacia la izquierda mediante la GPU -->
    <ul class="flex items-center justify-center md:justify-start [&_img]:max-w-none [&_svg]:max-w-none animate-infinite-scroll">
      {logos.map((logo) => (
        <li class="mx-8 grayscale opacity-30 invert hover:grayscale-0 hover:opacity-100 transition-all duration-300 transform hover:scale-105 hover:invert-0 cursor-default flex-shrink-0">
          <div set:html={logo.svg} class="text-zinc-400 group-hover:text-al13-cyan" title={logo.name}></div>
        </li>
      ))}
      
      <!-- Array Duplicado para crear el efecto de carrusel continuo al terminar -->
      {logos.map((logo) => (
        <li class="mx-8 grayscale opacity-30 invert hover:grayscale-0 hover:opacity-100 transition-all duration-300 transform hover:scale-105 hover:invert-0 cursor-default flex-shrink-0" aria-hidden="true">
          <div set:html={logo.svg} class="text-zinc-400 group-hover:text-al13-cyan" title={logo.name}></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Animación Optimizada por Hardware (GPU) */
  .animate-infinite-scroll {
    /* La distancia de translación debe cubrir exactamente la longitud de un set del array */
    animation: scroll 40s linear infinite;
    /* Activa la aceleración por hardware */
    will-change: transform; 
  }

  /* Pausar animación si el usuario se posa sobre la franja, mejorando la UX B2B */
  .animate-infinite-scroll:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    /* Desplaza hasta -50% del total de la pista (exactamente la longitud del primer array) */
    to { transform: translateX(-50%); }
  }
</style>
