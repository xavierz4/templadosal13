---
// Imports profundos: el barrel de lucide-svelte evalúa ~1500 módulos en SSR.
import Instagram from 'lucide-svelte/icons/instagram';
import MapPin from 'lucide-svelte/icons/map-pin';
import Mail from 'lucide-svelte/icons/mail';
import Phone from 'lucide-svelte/icons/phone';
import ShieldCheck from 'lucide-svelte/icons/shield-check';
---

<footer
  class="mt-auto border-t border-al13-glass-border bg-black py-16 text-zinc-400 relative overflow-hidden"
>
  <!-- Subtle glassmorphism glow -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[1px] bg-gradient-to-r from-transparent via-al13-cyan/20 to-transparent"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 relative z-10"
  >
    <!-- Brand -->
    <div class="space-y-6 lg:col-span-1">
      <a href="/" class="flex items-center gap-3 group inline-flex">
        <!-- SVG Logo (Simplified for brevity but keeping structure) -->
        <span class="text-2xl font-heading font-black tracking-tight text-white drop-shadow-md">
          AL<span class="text-al13-cyan">13</span>
        </span>
      </a>
      <p class="text-sm font-light leading-relaxed max-w-xs text-zinc-500">
        Innovación industrial en aluminio y cristal templado para proyectos B2B de alto calibre
        arquitectónico.
      </p>

      <!-- Social Media -->
      <div class="flex items-center space-x-4 pt-2">
        <a
          href="https://instagram.com/templadosal13"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-full border border-white/10 hover:border-al13-cyan hover:text-al13-cyan transition-colors"
          aria-label="Instagram"
        >
          <Instagram class="w-4 h-4" />
        </a>
        <a
          href="https://wa.me/573000000000"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-full border border-white/10 hover:border-green-400 hover:text-green-400 transition-colors"
          aria-label="WhatsApp"
        >
          <Phone class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Links -->
    <div class="space-y-6">
      <h3 class="text-white font-bold font-sans tracking-widest text-xs uppercase">Navegación</h3>
      <ul class="space-y-3 text-sm font-light">
        <li>
          <a
            href="/catalogo"
            data-astro-prefetch="hover"
            class="hover:text-al13-cyan transition-colors flex items-center group"
            ><span
              class="w-0 h-px bg-al13-cyan mr-0 group-hover:w-2 group-hover:mr-2 transition-all"
            ></span>Catálogo 3D</a
          >
        </li>
        <li>
          <a
            href="/nosotros"
            data-astro-prefetch="hover"
            class="hover:text-al13-cyan transition-colors flex items-center group"
            ><span
              class="w-0 h-px bg-al13-cyan mr-0 group-hover:w-2 group-hover:mr-2 transition-all"
            ></span>Nuestra Filosofía</a
          >
        </li>
        <li>
          <a
            href="/#cotizador"
            class="hover:text-al13-cyan transition-colors flex items-center group"
            ><span
              class="w-0 h-px bg-al13-cyan mr-0 group-hover:w-2 group-hover:mr-2 transition-all"
            ></span>Calculadora B2B</a
          >
        </li>
      </ul>
    </div>

    <!-- Contact -->
    <div class="space-y-6">
      <h3 class="text-white font-bold font-sans tracking-widest text-xs uppercase">
        Contacto Directo
      </h3>
      <ul class="space-y-4 text-sm font-light">
        <li class="flex items-start gap-3">
          <MapPin class="w-4 h-4 mt-0.5 text-zinc-500" />
          <span>Zona Industrial Montevideo<br />Bogotá, Colombia</span>
        </li>
        <li class="flex items-center gap-3">
          <Mail class="w-4 h-4 text-zinc-500" />
          <a
            href="mailto:comercial@templadosal13.com"
            class="hover:text-al13-cyan transition-colors">comercial@templadosal13.com</a
          >
        </li>
      </ul>
    </div>

    <!-- Badges & Certificaciones -->
    <div class="space-y-6">
      <h3 class="text-white font-bold font-sans tracking-widest text-xs uppercase">
        Garantía Industrial
      </h3>

      <div class="flex flex-col space-y-3">
        <div
          class="flex items-center space-x-3 p-3 rounded-lg bg-white/5 border border-white/10 w-fit"
        >
          <ShieldCheck class="w-6 h-6 text-al13-cyan" />
          <div class="flex flex-col">
            <span class="text-xs font-bold text-white uppercase tracking-wider"
              >Certificación ISO 9001</span
            >
            <span class="text-[10px] text-zinc-500">Gestión de Calidad</span>
          </div>
        </div>

        <div
          class="flex items-center gap-2 mt-4 opacity-60 grayscale hover:grayscale-0 transition-all"
        >
          <span class="text-xs font-bold mr-2">Pagos Verificados:</span>
          <!-- Mock payment methods -->
          <div class="w-8 h-5 bg-white/20 rounded-sm"></div>
          <div class="w-8 h-5 bg-white/20 rounded-sm"></div>
          <div class="w-8 h-5 bg-white/20 rounded-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="max-w-7xl mx-auto px-6 md:px-12 mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center text-[11px] uppercase tracking-widest font-mono text-zinc-500"
  >
    <p>&copy; {new Date().getFullYear()} Templados AL13. Todos los derechos reservados.</p>
    <div class="flex gap-6 mt-4 md:mt-0">
      <a href="/admin/login" class="hover:text-al13-cyan transition-colors">Portal Admin</a>
      <a href="/privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
      <a href="/terminos" class="hover:text-white transition-colors">Términos de Servicio</a>
    </div>
  </div>
</footer>
