---
/**
 * /admin/index.astro — Dashboard Principal del Admin Panel
 *
 * Usa AdminLayout que intercepta JWT cookie y redirige si no hay sesión.
 * Muestra KPIs reales (leads, catálogo) leídos server-side y accesos rápidos.
 */
import AdminLayout from '@shared/ui/AdminLayout.astro';
import { createSupabaseServerClient } from '@core/infrastructure/supabaseServer';
import { SupabaseLeadRepository } from '@core/infrastructure/repositories/SupabaseLeadRepository';
import { SupabaseCatalogRepository } from '@core/infrastructure/repositories/SupabaseCatalogRepository';
import type { AdminLead } from '@core/domain/leadAdminSchema';
import type { CatalogProject } from '@core/domain/catalogSchema';

// SSR obligatorio para auth con cookies
export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

let leads: AdminLead[] = [];
let projects: CatalogProject[] = [];
let loadError = '';

try {
  const leadRepo = new SupabaseLeadRepository(supabase);
  const catalogRepo = new SupabaseCatalogRepository(supabase);
  [leads, projects] = await Promise.all([leadRepo.getAll(), catalogRepo.getAll()]);
} catch (error: unknown) {
  loadError = error instanceof Error ? error.message : 'Error al cargar el resumen.';
  console.error('[Admin Dashboard] Load error:', error);
}

// ── KPIs derivados ──
const sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
const totalLeads = leads.length;
const newLeads7d = leads.filter((l) => new Date(l.created_at).getTime() >= sevenDaysAgo).length;
const wonLeads = leads.filter((l) => l.status === 'CERRADO_GANADO').length;
const totalProjects = projects.length;
const publishedProjects = projects.filter((p) => p.is_published).length;

// Últimos 5 leads para la lista de actividad reciente
const recentLeads = leads.slice(0, 5);
const productLabels: Record<string, string> = {
  cabina_ducha: 'Cabina de Ducha',
  divisor_oficina: 'Divisor de Oficina',
  fachada_monumental: 'Fachada Monumental',
  puerta_pivotante: 'Puerta Pivotante',
};
const statusLabels: Record<string, string> = {
  NUEVO: 'Nuevo',
  CONTACTADO: 'Contactado',
  COTIZADO: 'Cotizado',
  CERRADO_GANADO: 'Ganado',
  PERDIDO: 'Perdido',
};
---

<AdminLayout title="Dashboard" section="Dashboard">
  {loadError && <div class="fetch-error">⚠️ {loadError}</div>}

  <div class="dashboard-grid">
    <!-- Stat Cards -->
    <div class="stat-card">
      <div class="stat-icon stat-icon--leads">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"
          ></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
      <div class="stat-info">
        <p class="stat-label">Leads Totales</p>
        <p class="stat-value">{totalLeads}</p>
        <p class="stat-sub">{wonLeads} cerrados ganados</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon--pending">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="stat-info">
        <p class="stat-label">Leads Nuevos (7d)</p>
        <p class="stat-value">{newLeads7d}</p>
        <p class="stat-sub">Últimos 7 días</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon--catalog">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"
          ></rect>
          <rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"
          ></rect>
        </svg>
      </div>
      <div class="stat-info">
        <p class="stat-label">Proyectos Catálogo</p>
        <p class="stat-value">{totalProjects}</p>
        <p class="stat-sub">{publishedProjects} publicados</p>
      </div>
    </div>

    <!-- Actividad reciente -->
    <div class="recent-card">
      <div class="recent-header">
        <h2 class="recent-title">Leads recientes</h2>
        <a href="/admin/leads" class="recent-link">Ver todos →</a>
      </div>

      {
        recentLeads.length === 0 ? (
          <p class="recent-empty">
            Aún no hay leads registrados. Cuando un cliente use el cotizador, aparecerá aquí.
          </p>
        ) : (
          <ul class="recent-list">
            {recentLeads.map((lead) => (
              <li class="recent-item">
                <div class="recent-item-main">
                  <span class="recent-name">{lead.customer_name}</span>
                  <span class="recent-product">
                    {productLabels[lead.product_type] ?? lead.product_type}
                  </span>
                </div>
                <span class={`recent-status recent-status--${lead.status}`}>
                  {statusLabels[lead.status] ?? lead.status}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Accesos rápidos -->
    <div class="quick-card">
      <h2 class="recent-title">Accesos rápidos</h2>
      <div class="quick-links">
        <a href="/admin/leads" class="quick-link">
          <span class="quick-emoji">📋</span>
          <span>Gestionar Leads</span>
        </a>
        <a href="/admin/catalog" class="quick-link">
          <span class="quick-emoji">🖼️</span>
          <span>Añadir Proyecto</span>
        </a>
        <a href="/admin/analytics" class="quick-link">
          <span class="quick-emoji">📊</span>
          <span>Ver Telemetría</span>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Stats */
  .stat-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.875rem;
    transition: border-color 0.2s ease;
  }

  .stat-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-icon svg {
    width: 20px;
    height: 20px;
  }

  .stat-icon--leads {
    background: rgba(212, 175, 55, 0.1);
    color: #d4af37;
  }
  .stat-icon--pending {
    background: rgba(96, 165, 250, 0.1);
    color: #60a5fa;
  }
  .stat-icon--catalog {
    background: rgba(167, 139, 250, 0.1);
    color: #a78bfa;
  }

  .stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.25rem;
  }
  .stat-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #f5f5f5;
    line-height: 1;
  }
  .stat-sub {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.25);
    margin-top: 0.25rem;
  }

  /* Error banner */
  .fetch-error {
    padding: 0.875rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.75rem;
    color: #fca5a5;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }

  /* Recent leads + Quick links share the bottom row */
  .recent-card,
  .quick-card {
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.875rem;
  }
  .recent-card {
    grid-column: 1 / 3;
  }
  .quick-card {
    grid-column: 3 / -1;
  }

  .recent-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .recent-title {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #e0e0e0;
  }

  .recent-link {
    font-size: 0.75rem;
    color: #38bdf8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .recent-link:hover {
    color: #7dd3fc;
  }

  .recent-empty {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.5;
    padding: 1rem 0;
  }

  .recent-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .recent-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0.5rem;
  }

  .recent-item-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .recent-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #e0e0e0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .recent-product {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .recent-status {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .recent-status--NUEVO {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.12);
  }
  .recent-status--CONTACTADO {
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.12);
  }
  .recent-status--COTIZADO {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.12);
  }
  .recent-status--CERRADO_GANADO {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.12);
  }
  .recent-status--PERDIDO {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.12);
  }

  /* Quick links */
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.875rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.625rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .quick-link:hover {
    background: rgba(56, 189, 248, 0.06);
    border-color: rgba(56, 189, 248, 0.3);
    color: #fff;
  }
  .quick-emoji {
    font-size: 1.1rem;
  }

  /* Responsive: stack on narrow viewports */
  @media (max-width: 860px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
    .recent-card,
    .quick-card {
      grid-column: 1 / -1;
    }
  }
</style>
