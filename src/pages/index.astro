---
import PublicLayout from '@shared/ui/PublicLayout.astro';
import {
  Hero,
  TrustTicker,
  ValueProposition,
  QuantitativeImpact,
  ProjectGallery,
  SocialProof,
} from '@modules/landing';
import { TechnicalValidator } from '@modules/quoter';
import Footer from '@shared/ui/Footer.astro';
---

<PublicLayout
  title="Templados AL13 - Boutique Industrial en Vidrio Templado"
  description="Redefiniendo el estándar arquitectónico en cristal templado. Paneles 3D B2B/B2C para la era digital."
>
  <main>
    <!-- Sección 1: El Escaparate (Hero Cine) -->
    <Hero client:idle />

    <!-- Sección 1.5: Ticker de Autoridad B2B (Logos Infinitos) -->
    <TrustTicker />

    <!-- Sección 2: Propuesta de Valor (Feature List) -->
    <ValueProposition client:visible />

    <!-- Sección 2.5: Datos de Impacto Numérico (Autoridad B2B) -->
    <QuantitativeImpact client:visible />

    <!-- Sección 2.6: Galería de Proyectos Reales (Bento Grid) -->
    <ProjectGallery client:visible />

    <!-- Sección 2.8: Pruebas de Confianza (B2B Testimonials & Partners) -->
    <SocialProof client:visible />

    <!-- Sección 3: Calculadora Técnica (Geometry Feedback Live Engine) -->
    <section
      id="cotizador"
      class="py-24 bg-al13-dark border-t border-white/10 relative overflow-hidden"
    >
      <TechnicalValidator client:visible />
    </section>
  </main>

  <!-- El Pie Estático B2B -->
  <Footer />
</PublicLayout>
