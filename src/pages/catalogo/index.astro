---
/**
 * Public Catalog Page — Refactored for instant TTFB (2026-03-12)
 *
 * BEFORE: prerender=false → SSR blocking → Supabase call (~5-10s) → HTML sent
 * AFTER: prerender=true → HTML sent instantly → client fetches /api/catalog → cards appear
 *
 * REGLA 14 (Resiliencia): API endpoint handles errors gracefully (returns []).
 * REGLA 4 (UI Dumb): This page only renders the shell. JS handles data fetching.
 */
import PublicLayout from '@shared/ui/PublicLayout.astro';
import Footer from '@shared/ui/Footer.astro';
---

<PublicLayout
  title="Catálogo B2B | Templados AL13"
  description="Explora nuestros sistemas de cristal templado y aluminio estructural."
>
  <main class="min-h-screen pt-32 pb-24 px-6 md:px-12 bg-al13-black relative overflow-hidden">
    <!-- Texture overlay ultra-light (CSS Base64) to prevent CPU/GPU drops on feTurbulence -->
    <div
      class="absolute inset-0 pointer-events-none opacity-[0.03] z-0"
      style="background-image: url('data:image/png;base64,'); background-repeat: repeat;"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <!-- Headers -->
      <div class="mb-16">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white tracking-tight mb-4"
        >
          Catálogo <span class="text-zinc-500">B2B</span>
        </h1>
        <p class="text-zinc-400 text-lg max-w-2xl font-sans font-light">
          Explora nuestros sistemas arquitectónicos en detalle. Selecciona un producto para iniciar
          la experiencia inmersiva.
        </p>

        <!-- Category Filters -->
        <div class="mt-8 flex flex-wrap gap-3" id="catalog-filters">
          <button
            class="filter-btn active px-5 py-2 rounded-full border border-white/20 bg-white/10 text-white text-sm font-medium transition-colors hover:bg-white/20"
            data-filter="all">Todos</button
          >
          <button
            class="filter-btn px-5 py-2 rounded-full border border-zinc-800 bg-zinc-900/50 text-zinc-400 text-sm font-medium transition-colors hover:bg-zinc-800 hover:text-white"
            data-filter="cabina_ducha">Sistemas de Ducha</button
          >
          <button
            class="filter-btn px-5 py-2 rounded-full border border-zinc-800 bg-zinc-900/50 text-zinc-400 text-sm font-medium transition-colors hover:bg-zinc-800 hover:text-white"
            data-filter="puerta_pivotante">Puertas Batientes</button
          >
          <button
            class="filter-btn px-5 py-2 rounded-full border border-zinc-800 bg-zinc-900/50 text-zinc-400 text-sm font-medium transition-colors hover:bg-zinc-800 hover:text-white"
            data-filter="divisor_oficina">Divisiones de Oficina</button
          >
          <button
            class="filter-btn px-5 py-2 rounded-full border border-zinc-800 bg-zinc-900/50 text-zinc-400 text-sm font-medium transition-colors hover:bg-zinc-800 hover:text-white"
            data-filter="fachada_monumental">Fachadas Monumentales</button
          >
        </div>
      </div>

      <!-- Skeleton loading placeholders shown while data is fetched client-side -->
      <div
        id="catalog-skeleton"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8"
      >
        {
          Array.from({ length: 4 }).map(() => (
            <div class="aspect-square rounded-[1.5rem] bg-white/5 animate-pulse border border-white/5" />
          ))
        }
      </div>

      <!-- Real cards injected here by JS -->
      <!-- NOTE: style not class for display:grid — avoids Tailwind 'hidden vs grid' CSS specificity conflict -->
      <div
        id="catalog-grid"
        style="display:none"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8"
      >
      </div>

      <!-- Error state -->
      <div
        id="catalog-error"
        class="hidden py-20 text-center border border-white/5 rounded-2xl bg-white/5 backdrop-blur-sm"
      >
        <p class="text-zinc-500">No hay proyectos publicados en este momento.</p>
      </div>
    </div>
  </main>

  <Footer />
</PublicLayout>

<script>
  // ── Client-side data fetching (replaces blocking SSR Supabase call) ─────────
  // This script runs AFTER the page HTML is delivered — user sees the page instantly.
  // TTFB: ~100ms (static HTML) vs ~10000ms (SSR with Supabase round-trip).

  type CatalogProject = {
    id: string;
    title: string;
    category: string;
    description?: string;
    image_url: string;
    is_published: boolean;
  };

  const CATEGORY_LABELS: Record<string, string> = {
    cabina_ducha: 'Cabina de Ducha',
    divisor_oficina: 'División de Oficina',
    fachada_monumental: 'Fachada',
    puerta_pivotante: 'Puerta Pivotante',
  };

  function renderCard(project: CatalogProject): string {
    const label = CATEGORY_LABELS[project.category] ?? project.category;
    return `
      <a
        href="/sistemas/3d/${project.category}"
        data-category="${project.category}"
        data-astro-reload
        class="catalog-card group relative block w-full aspect-square rounded-[1.5rem] bg-al13-black overflow-hidden border border-white/5 hover:border-white/20 transition-all duration-300 shadow-[2px_4px_16px_rgba(0,0,0,0.5)] hover:shadow-[0_8px_32px_rgba(255,255,255,0.05)] cursor-pointer"
      >
        <div class="absolute inset-0">
          <img
            src="${project.image_url}"
            alt="${project.title}"
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            onerror="this.style.display='none'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-6">
          <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold tracking-widest uppercase border border-white/20 bg-white/5 text-zinc-400 mb-2">${label}</span>
          <h2 class="text-xl font-heading font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] leading-tight">${project.title}</h2>
        </div>

        <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span class="flex items-center gap-1 px-3 py-1.5 rounded-full bg-al13-cyan/20 border border-al13-cyan/30 text-al13-cyan text-xs font-bold">
            Ver 3D →
          </span>
        </div>
      </a>
    `;
  }

  function applyFilter(category: string) {
    const grid = document.getElementById('catalog-grid');
    if (!grid) return;
    const cards = grid.querySelectorAll<HTMLElement>('.catalog-card');
    cards.forEach((card) => {
      const show = category === 'all' || card.dataset.category === category;
      card.style.display = show ? 'block' : 'none';
    });

    // Update filter button states
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
      const isActive = btn.dataset.filter === category;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('bg-white/10', isActive);
      btn.classList.toggle('border-white/20', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('bg-zinc-900/50', !isActive);
      btn.classList.toggle('border-zinc-800', !isActive);
      btn.classList.toggle('text-zinc-400', !isActive);
    });
  }

  async function initCatalog() {
    const skeleton = document.getElementById('catalog-skeleton');
    const grid = document.getElementById('catalog-grid');
    const errorEl = document.getElementById('catalog-error');
    if (!grid || !skeleton || !errorEl) return;

    try {
      const response = await fetch('/api/catalog');
      const projects: CatalogProject[] = await response.json();

      skeleton.classList.add('hidden');

      if (projects.length === 0) {
        console.warn(
          '[Catalog] API returned 0 projects. Check Supabase connection and is_published flags.'
        );
        errorEl.classList.remove('hidden');
        return;
      }

      grid.innerHTML = projects.map(renderCard).join('');
      // Use inline style instead of classList to avoid Tailwind CSS specificity issues
      grid.style.display = 'grid';

      // Sync URL filter on init
      const urlParams = new URLSearchParams(window.location.search);
      const initialCat = urlParams.get('categoria') || 'all';
      applyFilter(initialCat);

      // Wire filter buttons
      document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.filter || 'all';
          applyFilter(cat);
          const newUrl = new URL(window.location.href);
          if (cat === 'all') {
            newUrl.searchParams.delete('categoria');
          } else {
            newUrl.searchParams.set('categoria', cat);
          }
          window.history.pushState({}, '', newUrl);
        });
      });
    } catch (error) {
      console.error('[Catalog] Failed to load projects:', error);
      skeleton.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  // Run on initial load and on Astro page transitions
  document.addEventListener('astro:page-load', initCatalog);
</script>
